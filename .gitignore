# Ignore everything
*
# ...even if they are in subdirectories
!*/

# But not these files/directories...
!*PKGBUILD*
!*.install
!*.desktop
!.gitignore
!README
!LICENSE

# Allow the dwm directory itself 
!dwm-6.0-current/ 

# Allow specific dwm source, patch, and config files 
!dwm-6.0-current/config.h 
!dwm-6.0-current/config.def.h 
!dwm-6.0-current/Makefile
!dwm-6.0-current/*.mk
!dwm-6.0-current/*.c 
!dwm-6.0-current/*.h
!dwm-6.0-current/*.patch
!dwm-6.0-source/config.h 
!dwm-6.0-source/config.def.h 
!dwm-6.0-source/Makefile 
!dwm-6.0-source/*.mk
!dwm-6.0-source/*.c 
!dwm-6.0-source/*.h
!dwm-6.0-source/*.patch
!dwm-6.0-tweak/config.h 
!dwm-6.0-tweak/config.def.h 
!dwm-6.0-tweak/Makefile 
!dwm-6.0-tweak/*.mk
!dwm-6.0-tweak/*.c 
!dwm-6.0-tweak/*.h
!dwm-6.0-tweak/*.patch
!dwm-6.1-tweak/config.h 
!dwm-6.1-tweak/config.def.h 
!dwm-6.1-tweak/Makefile 
!dwm-6.1-tweak/*.mk
!dwm-6.1-tweak/*.c 
!dwm-6.1-tweak/*.h
!dwm-6.1-tweak/*.patch
